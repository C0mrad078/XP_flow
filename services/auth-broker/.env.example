# XP FLOW Auth Broker — local development configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required. 32 raw bytes, base64-encoded, used for AES-256-GCM encryption
# of every token this broker persists. Generate one with:
#   openssl rand -base64 32
AUTH_BROKER_MASTER_KEY=

# Where the broker listens. Loopback-only by default for local development.
AUTH_BROKER_BIND_ADDR=127.0.0.1:8787

# This broker instance's own reachable base URL — used to build the Kwai
# callback URI it registers as its OAuth redirect. For local development
# this can stay as the loopback address; a real deployment needs a real
# HTTPS URL registered with Kwai's developer console.
AUTH_BROKER_PUBLIC_URL=http://127.0.0.1:8787

# Where the broker's own SQLite database file lives.
AUTH_BROKER_DATABASE_PATH=auth-broker.db

# TikTok Login Kit / Content Posting API credentials (developer console).
# Leave both unset to run without TikTok support — the broker starts fine
# and TikTok requests return BROKER_CONFIGURATION_ERROR.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Kwai Open Platform credentials. Same graceful-degradation rule as TikTok.
KWAI_APP_ID=
KWAI_APP_SECRET=
